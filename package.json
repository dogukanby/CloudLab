{
  "name": "cloud-systems-console",
  "version": "1.1.0",
  "description": "Twelve live, in-browser simulations of core cloud-systems concepts: load balancing, consistency, caching, failover, VPC, EC2, Elastic Beanstalk, Route 53, SNS, Snowball Edge, and sign-in flows.",
  "main": "main.js",
  "private": true,
  "author": "Doğukan Bayrı",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dogukanbayri.cloudsystemsconsole",
    "productName": "CloudLab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CloudLab-Setup.exe",
      "shortcutName": "CloudLab"
    }
  }
}
